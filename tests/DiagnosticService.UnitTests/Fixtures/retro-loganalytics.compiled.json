{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "6064977986497360405"
    }
  },
  "parameters": {
    "envName": {
      "type": "string",
      "maxLength": 13,
      "metadata": {
        "description": "Short environment suffix, lowercase alphanumeric (e.g. \"dev\", \"exp\")."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "diagServicePrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object (principal) ID of the identity the DiagnosticService authenticates as (the dedicated SP for the experiment). Receives ingest + query rights."
      }
    },
    "diagServicePrincipalType": {
      "type": "string",
      "defaultValue": "ServicePrincipal",
      "allowedValues": [
        "ServicePrincipal",
        "User"
      ],
      "metadata": {
        "description": "Principal type for the role assignments. ServicePrincipal for an SP/MI; User for a signed-in user account."
      }
    },
    "retentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Retention (days) for both the workspace and the Retro custom table."
      }
    }
  },
  "variables": {
    "laName": "[format('log-diag-{0}', parameters('envName'))]",
    "dceName": "[format('dce-diag-{0}', parameters('envName'))]",
    "dcrName": "[format('dcr-diag-{0}', parameters('envName'))]",
    "tableName": "DiagRetro_CL",
    "streamName": "Custom-DiagRetro_CL",
    "monitoringMetricsPublisherId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]",
    "logAnalyticsReaderId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '73c42c96-874c-492b-b04d-ab87d138a893')]",
    "retroColumns": [
      {
        "name": "TimeGenerated",
        "type": "datetime"
      },
      {
        "name": "Level",
        "type": "int"
      },
      {
        "name": "Machine",
        "type": "string"
      },
      {
        "name": "Process",
        "type": "string"
      },
      {
        "name": "User",
        "type": "string"
      },
      {
        "name": "Category",
        "type": "string"
      },
      {
        "name": "Message",
        "type": "string"
      },
      {
        "name": "Environment",
        "type": "string"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('laName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[parameters('retentionInDays')]"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/{1}', variables('laName'), variables('tableName'))]",
      "properties": {
        "plan": "Analytics",
        "retentionInDays": "[parameters('retentionInDays')]",
        "schema": {
          "name": "[variables('tableName')]",
          "columns": "[variables('retroColumns')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2023-03-11",
      "name": "[variables('dceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[variables('dcrName')]",
      "location": "[parameters('location')]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "streamDeclarations": {
          "[format('{0}', variables('streamName'))]": {
            "columns": "[variables('retroColumns')]"
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "name": "diagLa",
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "[variables('streamName')]"
            ],
            "destinations": [
              "diagLa"
            ],
            "transformKql": "source",
            "outputStream": "[variables('streamName')]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', variables('laName'), variables('tableName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName'))]",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), parameters('diagServicePrincipalId'), variables('monitoringMetricsPublisherId'))]",
      "properties": {
        "roleDefinitionId": "[variables('monitoringMetricsPublisherId')]",
        "principalId": "[parameters('diagServicePrincipalId')]",
        "principalType": "[parameters('diagServicePrincipalType')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]",
      "name": "[guid(resourceId('Microsoft.OperationalInsights/workspaces', variables('laName')), parameters('diagServicePrincipalId'), variables('logAnalyticsReaderId'))]",
      "properties": {
        "roleDefinitionId": "[variables('logAnalyticsReaderId')]",
        "principalId": "[parameters('diagServicePrincipalId')]",
        "principalType": "[parameters('diagServicePrincipalType')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]"
      ]
    }
  ],
  "outputs": {
    "dceEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2023-03-11').logsIngestion.endpoint]"
    },
    "dcrImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), '2023-03-11').immutableId]"
    },
    "streamName": {
      "type": "string",
      "value": "[variables('streamName')]"
    },
    "tableName": {
      "type": "string",
      "value": "[variables('tableName')]"
    },
    "workspaceId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('laName')), '2023-09-01').customerId]"
    },
    "workspaceResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]"
    }
  }
}